{
    "private": true,
    "name": "@workadventure/agent-platform",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "lint": "eslint src tests vitest.config.ts",
        "lint-fix": "eslint --fix src tests vitest.config.ts",
        "pretty": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' '*.ts' '*.json'",
        "pretty-check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' '*.ts' '*.json'"
    },
    "dependencies": {
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "catch-unknown": "^2.0.0",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^7.0.0",
        "openapi-types": "^12.1.3",
        "pg": "^8.23.0",
        "redis": "^5.12.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/pg": "^8.23.1",
        "@workadventure/eslint-config": "1.0.0",
        "eslint": "^9.39.4",
        "prettier": "^3.8.3",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    }
}
